<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bixy.dj-love</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/abie/.hermes/scripts/dj-love-launcher.sh</string>
    </array>

    <!-- 周一凌晨 3:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
        <key>Weekday</key>
        <integer>1</integer>  <!-- 周一 = 1 -->
    </dict>

    <!-- 如果错过了（关机没跑成），开机后立即补跑 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/abie/Music/BIXY DJ/dj-love.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/abie/Music/BIXY DJ/dj-love.log</string>
</dict>
</plist>
